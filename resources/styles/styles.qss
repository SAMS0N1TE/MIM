/* Compact Windows classic metrics, square bevels, native focus cues. */
QWidget { background: #d4d0c8; color: #000; font-family: Tahoma; font-size: 8pt; }
QLabel { background: transparent; }
QPushButton { border: 2px solid; border-top-color: #fff; border-left-color: #fff;
 border-bottom-color: #404040; border-right-color: #404040; padding: 3px 9px; min-height: 16px; }
QPushButton:pressed { border-top-color: #404040; border-left-color: #404040;
 border-bottom-color: #fff; border-right-color: #fff; padding-top: 4px; padding-bottom: 2px; }
QPushButton:focus { outline: 1px dotted #000; outline-offset: -5px; }
QPushButton:disabled, QToolButton:disabled { color: #808080; }
QLineEdit, QTextEdit, QTreeView, QListWidget, QDoubleSpinBox, QSpinBox {
 background: #fff; border: 2px solid; border-top-color: #808080; border-left-color: #808080;
 border-bottom-color: #fff; border-right-color: #fff; padding: 2px;
 selection-background-color: #000080; selection-color: #fff; }
QTextEdit { font-family: Arial; font-size: 10pt; }
QTreeView { alternate-background-color: #fff; show-decoration-selected: 0; }
QTreeView::item { height: 18px; padding: 0; }
QTreeView::item:selected { background: #000080; color: #fff; }
QComboBox { background: #fff; padding: 2px 3px; min-height: 17px; }
QComboBox QAbstractItemView { background: #fff; selection-background-color: #000080; selection-color: #fff; }
QMenuBar { padding: 0; }
QMenuBar::item { padding: 3px 6px; background: transparent; }
QMenuBar::item:selected, QMenu::item:selected { background: #000080; color: #fff; }
QMenu { border: 2px outset #fff; padding: 2px; }
QMenu::item { padding: 4px 22px; }
QMenu::separator { height: 1px; background: #808080; margin: 3px; }
QToolBar { border: none; spacing: 1px; padding: 1px; }
QToolButton { padding: 2px; border: 1px solid transparent; }
QToolButton:hover { border: 1px outset #fff; }
QToolButton:pressed, QToolButton:checked { border: 1px inset #808080; }
QTabWidget::pane { border: 1px solid #808080; }
QTabBar::tab { padding: 4px 9px; border: 1px solid #808080; margin-right: 1px; }
QTabBar::tab:selected { border-bottom-color: #d4d0c8; background: #d4d0c8; }
QStatusBar { border-top: 1px solid #808080; min-height: 19px; }
QStatusBar::item { border: 1px inset #fff; }
QGroupBox { border: 1px solid #808080; margin-top: 9px; padding: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 3px; }
QCheckBox { spacing: 4px; }
QLabel#conversationHeading { padding: 3px; }
